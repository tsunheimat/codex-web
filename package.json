{
  "name": "codex-web",
  "version": "0.0.1",
  "files": [
    "README.md",
    "scratch/asar/**/*",
    "scratch/gateway-web/**/*",
    "src/server/**/*.js",
    "src/server/electron/index.js",
    "!**/*.ts"
  ],
  "bin": {
    "codex-web": "src/server/main.js",
    "codex-web-gateway": "src/server/gateway/main.js"
  },
  "scripts": {
    "prepare": "./scripts/prepare && npm run build:browser && npm run build:server",
    "build": "npm run prepare:asar && npm run build:browser && npm run build:server",
    "launch:unpacked:server": "http-server ./scratch/asar/webview -a localhost -p 5175 -c-1",
    "launch:unpacked": "NODE_ENV=development electron ./scratch/asar --remote-debugging-port=9222",
    "dev:browser": "vite --config vite.browser.config.ts",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:server": "cd src/server && tsc",
    "prepare:asar": "./scripts/prepare_asar",
    "preserver": "npm run build:server && npm run build:browser",
    "server": "CODEX_CLI_PATH=$(which codex) node src/server/main.js",
    "test": "npm run build:server && node --test test/*.test.cjs",
    "test:browser:install": "playwright install chromium",
    "test:browser": "npm run build:server && npm run build:browser && xvfb-run -a node scripts/test_browser_lifecycle.cjs",
    "test:browser:restart": "npm run build:server && npm run build:browser && xvfb-run -a node scripts/test_browser_restart_lifecycle.cjs",
    "test:browser:pod-restart": "npm run build:server && npm run build:browser && CODEX_WEB_RESTART_TOPOLOGY=owned xvfb-run -a node scripts/test_browser_restart_lifecycle.cjs",
    "test:runtime": "node scripts/test_runtime_smoke.cjs",
    "test:runtime:overload": "node scripts/test_runtime_overload.cjs",
    "test:terminal": "node scripts/test_terminal_pty.cjs",
    "build:gateway:web": "tsc -p src/gateway-web/tsconfig.json && vite build --config vite.gateway.config.ts",
    "gateway": "node src/server/gateway/main.js",
    "dev:gateway:web": "vite --config vite.gateway.config.ts",
    "test:gateway": "npm run build:server && node --test test/gateway-*.test.cjs",
    "mobile:sync": "npm run build:gateway:web && cap sync",
    "mobile:add:android": "npm run build:gateway:web && cap add android",
    "mobile:add:ios": "npm run build:gateway:web && cap add ios",
    "test:gateway:browser": "npm run build:server && npm run build:gateway:web && node scripts/test_gateway_browser.cjs"
  },
  "repository": "git@github.com:0xcaff/codex-web.git",
  "author": "martin <martincharles07@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@electron/asar": "^4.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.1",
    "@tanstack/react-query": "^5.100.9",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "^12.9.0",
    "fastify": "^5.8.5",
    "glob": "^13.0.6",
    "https-proxy-agent": "^9.1.0",
    "node-pty": "1.1.0",
    "prettier": "^3.8.2",
    "proxy-from-env": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp-cli": "^5.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/proxy-from-env": "^1.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "41.2.0",
    "http-server": "^14.1.1",
    "playwright": "^1.58.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

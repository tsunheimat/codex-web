+          op: "message/submit",
+          conversationId: params.conversationId,
+          prompt: params.prompt,
+          attachments,
+          prepared,
+        });
+        return {
+          conversationId: params.conversationId,
+          messageId,
+          attachmentIds: params.attachmentIds,
+          attachmentReferences: prepared.references,
+          submitted: true,
+        };
+      }

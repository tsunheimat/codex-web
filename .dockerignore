# Deny everything unless it is required to build the production image.
**

!Dockerfile
!Dockerfile.gateway
!.dockerignore
!package.json
!package-lock.json
!vite.browser.config.ts
!vite.gateway.config.ts
!container-init.sh

!assets/
!assets/**
!patches/
!patches/**
!scripts/
!scripts/prepare
!scripts/prepare_asar
!src/
!src/**

# Keep generated, local, secret, and test material out of the build context.
.git/
.github/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

scratch/
dist/
build/
coverage/
.cache/
.npm/
.pnpm-store/
.turbo/
.vite/

test/
scripts/test_*

.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.sqlite
*.db

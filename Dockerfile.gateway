FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && npm rebuild node-pty --foreground-scripts
COPY src ./src
COPY vite.gateway.config.ts ./
RUN npm run build:server && npm run build:gateway:web
RUN npm prune --omit=dev --ignore-scripts

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client python3 tmux ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/src/server ./src/server
COPY --from=build --chown=node:node /app/scratch/gateway-web ./scratch/gateway-web
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 8215
ENTRYPOINT ["node", "src/server/gateway/main.js"]
CMD ["/config/gateway.json"]

# Copy to .env and edit only the values you need.
# Run docker login ghcr.io only if your GHCR pull requires authenticated access.

# Use a sha tag or digest for immutable deployments.
# CODEX_WEB_IMAGE=ghcr.io/tsunheimat/codex-web:sha-...
# CODEX_WEB_IMAGE=ghcr.io/tsunheimat/codex-web@sha256:<digest>
CODEX_WEB_IMAGE=ghcr.io/tsunheimat/codex-web:latest

# Keep loopback by default. Use 0.0.0.0 only behind a trusted reverse proxy.
CODEX_WEB_BIND_ADDRESS=127.0.0.1
CODEX_WEB_PORT=8214

# Make this directory writable by the container user your runtime uses.
CODEX_WEB_WORKSPACE_DIR=./workspace

# DANGER: true lets Browser users access every path visible inside the container.
# Host paths must still be bind-mounted into the container to become visible.
CODEX_WEBUI_ALLOW_ANY_PROJECT=false
